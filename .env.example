# 复制为 .env 使用（仅本地开发；生产部署请用平台环境变量）
# 项目不依赖 dotenv 包，server/config.js 会自动读取项目根目录的 .env。

# 监听地址 / 端口
HOST=0.0.0.0
PORT=3000

# 运行数据目录（state.json / ledger.jsonl / admin.local.json）
DATA_DIR=./data

# 管理员口令与后台入口路径
# 生产环境必须修改；未设置 ADMIN_PASSWORD 且 NODE_ENV=production 时服务会拒绝启动
ADMIN_PASSWORD=change-me-to-a-long-random-password
ADMIN_ENTRY_PATH=/nantang-admin.html

# 生产环境设为 production（Cookie 会自动附加 Secure；此时 ADMIN_PASSWORD 必填）
NODE_ENV=development

# 强制 Cookie Secure（HTTPS 部署时建议 true；默认跟随 NODE_ENV）
# COOKIE_SECURE=false
